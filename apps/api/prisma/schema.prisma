generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  name           String?
  username       String?         @unique
  email          String          @unique
  passwordHash   String?         @map("password_hash")
  avatarUrl      String?         @map("avatar_url")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  isSystemAdmin  Boolean         @default(false) @map("is_system_admin")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  accounts       Account[]
  athleteProfile AthleteProfile?
  auditLogs      AuditLog[]
  clubsOwned     Club[]          @relation("ClubOwner")
  invites        Invite[]        @relation("InviteAuthor")
  members_on     Member[]
  raceResults    RaceResult[]
  raceParticipations RaceParticipant[]
  rankings       Ranking[]
  tokens         Token[]
  workouts       Workout[]
  workoutReactions WorkoutReaction[]
  feedbacks      SystemFeedback[]

  @@map("users")
}

model Account {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Token {
  id        String    @id @default(uuid())
  type      TokenType
  code      String?
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Club {
  id                        String    @id @default(uuid())
  name                      String
  slug                      String    @unique
  domain                    String?   @unique
  cnpj                      String?   @unique
  inviteToken               String?   @unique @map("invite_token")
  shouldAttachUsersByDomain Boolean   @default(false) @map("should_attach_users_by_domain")
  avatarUrl                 String?   @map("avatar_url")
  stripeCustomerId          String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId      String?   @unique @map("stripe_subscription_id")
  subscriptionStatus        String?   @map("subscription_status")
  description               String?
  city                      String?
  state                     String?
  bannerUrl                 String?   @map("banner_url")
  status                    ClubStatus @default(ACTIVE)
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  ownerId                   String    @map("owner_id")
  owner                     User      @relation("ClubOwner", fields: [ownerId], references: [id])
  invites                   Invite[]
  invoices                  Invoice[]
  members                   Member[]
  races                     Race[]
  rankings                  Ranking[]
  workouts                  Workout[]

  @@map("clubs")
}

enum ClubStatus {
  ACTIVE
  DEACTIVATED
}

model Invite {
  id        String   @id @default(uuid())
  email     String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id")
  clubId    String   @map("club_id")
  author    User?    @relation("InviteAuthor", fields: [authorId], references: [id])
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([email, clubId])
  @@index([email])
  @@map("invites")
}

model Member {
  id       String       @id @default(uuid())
  role     Role         @default(ATHLETE)
  status   MemberStatus @default(ACTIVE)
  clubId   String       @map("club_id")
  userId   String       @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")
  invoices Invoice[]
  club     Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("members")
}

model AthleteProfile {
  id                    String    @id @default(uuid())
  paceAvg               Float?
  weight                Float?
  height                Int?
  gender                Gender?
  birthDate             DateTime  @default("2000-01-01T00:00:00.000Z") @map("birth_date")
  bio                   String?
  city                  String?
  instagramUrl          String?   @map("instagram_url")
  youtubeUrl            String?   @map("youtube_url")
  stravaUrl             String?   @map("strava_url")
  coverUrl              String?   @map("cover_url")
  isPublic              Boolean   @default(true) @map("is_public")
  isPremium             Boolean   @default(false) @map("is_premium")

  // Equipamentos vestíveis (opcionais)
  shoes                 String?   @map("shoes")
  watch                 String?   @map("watch")
  shoesMaxDistance       Float?    @map("shoes_max_distance")
  shoesRemainingDistance Float?    @map("shoes_remaining_distance")

  // Dados Médicos (Resguardo)
  hasMedicalConditions  Boolean   @default(false) @map("has_medical_conditions")
  medicalConditions     String?   @map("medical_conditions")

  // Conexão Strava (Simulada)
  stravaAthleteId      String?   @unique @map("strava_athlete_id")
  stravaAccessToken    String?   @map("strava_access_token")
  stravaRefreshToken   String?   @map("strava_refresh_token")
  stravaTokenExpiresAt DateTime? @map("strava_token_expires_at")

  userId                String    @unique @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("athlete_profiles")
}

model Workout {
  id             String         @id @default(uuid())
  title          String?
  distance       Float
  duration       Float?
  pace           Float?
  type           WorkoutType
  status         WorkoutStatus @default(COMPLETED)
  assignmentMode WorkoutMode?  @map("assignment_mode")
  slug           String?        @unique
  date           DateTime
  notes          String?
  visibility     Visibility     @default(PUBLIC)
  imageUrl       String?
  routeData      Json?          @map("route_data")
  rescheduleCount Int           @default(0) @map("reschedule_count")
  originalDate   DateTime?      @map("original_date")
  
  // Metas Originais para cálculo de desvio
  targetDistance Float?         @map("target_distance")
  targetDuration Float?         @map("target_duration")

  // Link Strava
  stravaActivityId String?      @unique @map("strava_activity_id")
  syncSource       String?      @default("MANUAL") @map("sync_source")
  shoesUsed        String?      @map("shoes_used")
  reactions      WorkoutReaction[]

  createdAt      DateTime       @default(now()) @map("created_at")
  clubId         String         @map("club_id")
  athleteId      String         @map("athlete_id")
  athlete        User           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  club           Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([athleteId])
  @@map("workouts")
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
}

enum WorkoutMode {
  GOAL
  FREE
}

enum RacePaymentStatus {
  PENDING
  CONFIRMED
}

model Race {
  id        String       @id @default(uuid())
  name      String
  distance  Float
  city      String
  date      DateTime
  imageUrl  String?      @map("image_url")
  routeData Json?        @map("route_data")
  createdAt DateTime     @default(now()) @map("created_at")
  clubId    String       @map("club_id")
  results   RaceResult[]
  participants RaceParticipant[]
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("races")
}

model RaceParticipant {
  id            String            @id @default(uuid())
  createdAt     DateTime          @default(now()) @map("created_at")
  raceId        String            @map("race_id")
  athleteId     String            @map("athlete_id")
  paymentStatus RacePaymentStatus @default(PENDING) @map("payment_status")
  athlete       User              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race          Race              @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, athleteId])
  @@map("race_participants")
}

model RaceResult {
  id        String   @id @default(uuid())
  time      Int
  position  Int?
  pace      Float?
  shoesUsed String?  @map("shoes_used")
  createdAt DateTime @default(now()) @map("created_at")
  raceId    String   @map("race_id")
  athleteId String   @map("athlete_id")
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, athleteId])
  @@map("race_results")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String   @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@map("audit_logs")
}

model Ranking {
  id        String   @id @default(uuid())
  year      Int
  month     Int?
  week      Int?
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  clubId    String   @map("club_id")
  athleteId String   @map("athlete_id")
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, athleteId, year, month, week])
  @@index([clubId])
  @@map("rankings")
}

model Invoice {
  id          String        @id @default(uuid())
  amount      Float
  description String
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime      @map("due_date")
  paidAt      DateTime?     @map("paid_at")
  clubId      String        @map("club_id")
  memberId    String        @map("member_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  club        Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member      Member        @relation(fields: [memberId], references: [id])

  @@map("invoices")
}

enum TokenType {
  PASSWORD_RECOVER
  EMAIL_VERIFICATION
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

enum Role {
  OWNER
  MANAGER
  ADMIN
  ATHLETE
  COACH
  BILLING
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum Visibility {
  PUBLIC
  COACH_ONLY
  PRIVATE
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum WorkoutType {
  EASY
  INTERVAL
  TEMPO
  LONG
  RECOVERY
  RACE
  STRENGTH
  WALK
}

model WorkoutReaction {
  id        String   @id @default(uuid())
  type      String   // "LIKE", "FIRE", "CLAP", "TROPHY"
  createdAt DateTime @default(now()) @map("created_at")
  workoutId String   @map("workout_id")
  userId    String   @map("user_id")

  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
  @@map("workout_reactions")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlists")
}

model SystemFeedback {
  id        String   @id @default(uuid())
  type      String   // "BUG", "SUGGESTION", "OTHER"
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("system_feedbacks")
}
