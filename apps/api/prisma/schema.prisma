generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  name           String?
  email          String          @unique
  passwordHash   String?         @map("password_hash")
  avatarUrl      String?         @map("avatar_url")
  isSystemAdmin  Boolean         @default(false) @map("is_system_admin")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  accounts       Account[]
  athleteProfile AthleteProfile?
  auditLogs      AuditLog[]
  clubsOwned     Club[]          @relation("ClubOwner")
  invites        Invite[]        @relation("InviteAuthor")
  members_on     Member[]
  raceResults    RaceResult[]
  rankings       Ranking[]
  tokens         Token[]
  workouts       Workout[]

  @@map("users")
}

model Account {
  id                String        @id @default(uuid())
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  userId            String        @map("user_id")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Token {
  id        String    @id @default(uuid())
  type      TokenType
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Club {
  id                        String    @id @default(uuid())
  name                      String
  slug                      String    @unique
  domain                    String?   @unique
  cnpj                      String?   @unique
  shouldAttachUsersByDomain Boolean   @default(false) @map("should_attach_users_by_domain")
  avatarUrl                 String?   @map("avatar_url")
  stripeCustomerId          String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId      String?   @unique @map("stripe_subscription_id")
  subscriptionStatus        String?   @map("subscription_status")
  description               String?
  city                      String?
  state                     String?
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  ownerId                   String    @map("owner_id")
  owner                     User      @relation("ClubOwner", fields: [ownerId], references: [id])
  invites                   Invite[]
  invoices                  Invoice[]
  members                   Member[]
  races                     Race[]
  rankings                  Ranking[]
  workouts                  Workout[]

  @@map("clubs")
}

model Invite {
  id        String   @id @default(uuid())
  email     String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  authorId  String?  @map("author_id")
  clubId    String   @map("club_id")
  author    User?    @relation("InviteAuthor", fields: [authorId], references: [id])
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([email, clubId])
  @@index([email])
  @@map("invites")
}

model Member {
  id       String       @id @default(uuid())
  role     Role         @default(MEMBER)
  status   MemberStatus @default(ACTIVE)
  clubId   String       @map("club_id")
  userId   String       @map("user_id")
  invoices Invoice[]
  club     Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("members")
}

model AthleteProfile {
  id           String    @id @default(uuid())
  paceAvg      Float?
  weight       Float?
  height       Int?
  gender       Gender?
  birthDate    DateTime?
  bio          String?
  city         String?
  instagramUrl String?   @map("instagram_url")
  youtubeUrl   String?   @map("youtube_url")
  stravaUrl    String?   @map("strava_url")
  isPublic     Boolean   @default(true) @map("is_public")
  userId       String    @unique @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("athlete_profiles")
}

model Workout {
  id             String         @id @default(uuid())
  title          String?
  distance       Float
  duration       Float?
  pace           Float?
  type           WorkoutType
  status         WorkoutStatus @default(COMPLETED)
  assignmentMode WorkoutMode?  @map("assignment_mode")
  slug           String?        @unique
  date           DateTime
  notes          String?
  visibility     Visibility     @default(PUBLIC)
  imageUrl       String?
  createdAt      DateTime       @default(now()) @map("created_at")
  clubId         String         @map("club_id")
  athleteId      String         @map("athlete_id")
  athlete        User           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  club           Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("workouts")
}

enum WorkoutStatus {
  PLANNED
  COMPLETED
}

enum WorkoutMode {
  GOAL
  FREE
}

model Race {
  id        String       @id @default(uuid())
  name      String
  distance  Float
  city      String
  date      DateTime
  imageUrl  String?
  createdAt DateTime     @default(now()) @map("created_at")
  clubId    String       @map("club_id")
  results   RaceResult[]
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("races")
}

model RaceResult {
  id        String   @id @default(uuid())
  time      Int
  position  Int?
  pace      Float?
  createdAt DateTime @default(now()) @map("created_at")
  raceId    String   @map("race_id")
  athleteId String   @map("athlete_id")
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, athleteId])
  @@map("race_results")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String   @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Ranking {
  id        String   @id @default(uuid())
  year      Int
  month     Int?
  week      Int?
  points    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  clubId    String   @map("club_id")
  athleteId String   @map("athlete_id")
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, athleteId, year, month, week])
  @@index([clubId])
  @@map("rankings")
}

model Invoice {
  id          String        @id @default(uuid())
  amount      Float
  description String
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime      @map("due_date")
  paidAt      DateTime?     @map("paid_at")
  clubId      String        @map("club_id")
  memberId    String        @map("member_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  club        Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  member      Member        @relation(fields: [memberId], references: [id])

  @@map("invoices")
}

enum TokenType {
  PASSWORD_RECOVER
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

enum Role {
  OWNER
  MANAGER
  ADMIN
  MEMBER
  COACH
  BILLING
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum Visibility {
  PUBLIC
  COACH_ONLY
  PRIVATE
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum WorkoutType {
  EASY
  INTERVAL
  TEMPO
  LONG
  RECOVERY
  RACE
  STRENGTH
  WALK
}
