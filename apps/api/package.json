{
  "name": "@saas/api",
  "version": "1.0.0",
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "dev": "pnpm env:load tsx watch src/http/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "pnpm env:load prisma migrate dev",
    "db:studio": "pnpm env:load prisma studio",
    "db:seed": "pnpm env:load tsx prisma/seed.ts",
    "env:load": "dotenv -e ../../.env --",
    "test": "vitest run --project unit",
    "test:e2e": "pnpm env:load vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:e2e:watch": "pnpm env:load vitest --project e2e",
    "test:coverage": "pnpm env:load vitest run --coverage",
    "test:ui": "pnpm env:load vitest --ui"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "10.2.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@saas/auth": "workspace:*",
    "@saas/env": "workspace:*",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "fastify": "5.11.3",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.16.3",
    "resend": "^6.12.2",
    "sharp": "0.35.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@saas/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "4.1.4",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.1.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  },
  "prisma": {
    "seed": "pnpm env:load tsx prisma/seed.ts "
  }
}
